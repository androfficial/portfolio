---
interface Props {
  label: string;
}

const { label } = Astro.props;

const sources = [
  { name: 'FACEBOOK', x: 30, at: 0 },
  { name: 'APPLOVIN', x: 195, at: 0.08 },
  { name: 'GOOGLE ADS', x: 360, at: 0.16 },
];

const sourcePaths = ['M95 80C95 150 260 128 260 194', 'M260 80V194', 'M425 80C425 150 260 128 260 194'];

const options = [
  { y: 288, selected: false },
  { y: 316, selected: true },
  { y: 344, selected: false },
];

const branchPaths = ['M260 534C260 556 120 546 120 566', 'M260 534C260 556 380 546 380 566'];
---

<svg class="block h-auto w-full" viewBox="0 0 520 620" role="img" aria-labelledby="fabu-visual-title" data-visual>
  <title id="fabu-visual-title">{label}</title>
  <defs>
    <pattern id="fabu-dots" width="22" height="22" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1.1" fill="rgb(168 190 228 / 0.14)"></circle>
    </pattern>
    <radialGradient id="fabu-halo" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ff7a5c" stop-opacity="0.32"></stop>
      <stop offset="1" stop-color="#ff7a5c" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="fabu-teal-halo" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#3ad6c3" stop-opacity="0.2"></stop>
      <stop offset="1" stop-color="#3ad6c3" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <rect width="520" height="620" fill="url(#fabu-dots)"></rect>
  <ellipse cx="260" cy="290" rx="200" ry="150" fill="url(#fabu-teal-halo)"></ellipse>
  <ellipse cx="380" cy="584" rx="130" ry="48" fill="url(#fabu-halo)"></ellipse>

  <g>
    {
      sourcePaths.map((path, index) => (
        <path class="v-path" d={path} pathLength="1" data-enter="draw" data-enter-at={0.35 + index * 0.06} />
      ))
    }
    {sourcePaths.map((path) => <path class="v-flow flow-dash" d={path} data-enter="fade" data-enter-at="1.4" />)}
    <path class="v-path" d="M260 380V424" pathLength="1" data-enter="draw" data-enter-at="1.2"></path>
    <path class="v-flow flow-dash" d="M260 380V424" data-enter="fade" data-enter-at="1.6"></path>
    {
      branchPaths.map((path, index) => (
        <path class="v-path" d={path} pathLength="1" data-enter="draw" data-enter-at={1.6 + index * 0.06} />
      ))
    }
    {branchPaths.map((path) => <path class="v-flow flow-dash" d={path} data-enter="fade" data-enter-at="2.1" />)}
  </g>

  <g data-depth="0.6">
    {
      sources.map((source) => (
        <g data-enter="drop" data-enter-at={source.at}>
          <rect class="v-node" x={source.x} y="40" width="130" height="40" rx="20" />
          <text class="v-label" x={source.x + 65} y="64" text-anchor="middle">
            {source.name}
          </text>
        </g>
      ))
    }
  </g>

  <g data-depth="0.25">
    <rect
      class="v-card"
      x="174"
      y="214"
      width="172"
      height="186"
      rx="18"
      opacity="0.35"
      data-enter="rise"
      data-enter-at="0.7"></rect>
    <rect
      class="v-card"
      x="162"
      y="204"
      width="196"
      height="186"
      rx="18"
      opacity="0.6"
      data-enter="rise"
      data-enter-at="0.76"></rect>
    <g data-enter="rise" data-enter-at="0.82">
      <rect class="v-card" x="150" y="194" width="220" height="186" rx="18"></rect>
      <text class="v-label" x="170" y="222">QUIZ</text>
      <circle cx="322" cy="218" r="3" fill="#3ad6c3"></circle>
      <circle cx="333" cy="218" r="3" fill="#3ad6c3"></circle>
      <circle cx="344" cy="218" r="3" fill="rgb(168 190 228 / 0.3)"></circle>
      <circle cx="355" cy="218" r="3" fill="rgb(168 190 228 / 0.3)"></circle>
      <rect x="170" y="234" width="180" height="4" rx="2" fill="rgb(168 190 228 / 0.18)"></rect>
      <rect x="170" y="234" width="76" height="4" rx="2" fill="#3ad6c3" data-enter="grow" data-enter-at="1.3"></rect>
      <rect x="170" y="252" width="150" height="9" rx="4.5" fill="#e8eef8" opacity="0.8"></rect>
      <rect x="170" y="268" width="104" height="7" rx="3.5" fill="#7d8ba3" opacity="0.6"></rect>
      {
        options.map((option) => (
          <g>
            <rect
              x="170"
              y={option.y}
              width="180"
              height="22"
              rx="11"
              fill={option.selected ? 'rgb(58 214 195 / 0.12)' : 'none'}
              stroke={option.selected ? '#3ad6c3' : 'rgb(168 190 228 / 0.28)'}
            />
            <circle
              cx="184"
              cy={option.y + 11}
              r="4"
              fill={option.selected ? '#3ad6c3' : 'none'}
              stroke={option.selected ? 'none' : 'rgb(168 190 228 / 0.4)'}
            />
            <rect
              x="196"
              y={option.y + 8.5}
              width={option.selected ? 96 : 80}
              height="5"
              rx="2.5"
              fill="#7d8ba3"
              opacity="0.55"
            />
          </g>
        ))
      }
    </g>
  </g>

  <g data-depth="0.4">
    <path class="v-path" d="M370 246H392"></path>
    <path class="v-path" d="M370 286H392"></path>
    <g data-enter="slide" data-enter-at="1.1">
      <rect class="v-node" x="392" y="230" width="46" height="32" rx="16"></rect>
      <text class="v-letter" x="415" y="251" text-anchor="middle">A</text>
    </g>
    <g data-enter="slide" data-enter-at="1.2">
      <rect class="v-node" x="392" y="270" width="46" height="32" rx="16"></rect>
      <text class="v-letter" x="415" y="291" text-anchor="middle">B</text>
    </g>
    <rect
      class="ab-ring"
      x="388"
      y="226"
      width="54"
      height="40"
      rx="20"
      fill="none"
      stroke="#ff7a5c"
      stroke-width="1.5"
      data-enter="fade"
      data-enter-at="1.5"></rect>
    <text class="v-label" x="415" y="330" text-anchor="middle">A/B</text>
  </g>

  <g data-depth="0.1">
    <g data-enter="fade" data-enter-at="1.6">
      <path d="M146 480a14 14 0 1 1-4.1-9.9" fill="none" stroke="#3ad6c3" stroke-width="1.6" stroke-linecap="round"
      ></path>
      <path
        d="m141.2 464.6.9 6.2 6.1-1.1"
        fill="none"
        stroke="#3ad6c3"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <text class="v-label" x="132" y="514" text-anchor="middle">FALLBACK</text>
    </g>
    <g data-enter="rise" data-enter-at="1.3">
      <rect class="v-card" x="170" y="424" width="180" height="110" rx="18"></rect>
      <text class="v-label" x="190" y="452">CHECKOUT</text>
      <path d="M325 448v-3.5a5 5 0 0 1 10 0v3.5" fill="none" stroke="#7d8ba3" stroke-width="1.6"></path>
      <rect x="322" y="448" width="16" height="11" rx="2.5" fill="#7d8ba3" opacity="0.8"></rect>
      <rect x="190" y="470" width="140" height="10" rx="5" fill="rgb(168 190 228 / 0.2)"></rect>
      <rect x="190" y="487" width="92" height="10" rx="5" fill="rgb(168 190 228 / 0.2)"></rect>
      <rect x="190" y="505" width="140" height="18" rx="9" fill="#ff7a5c"></rect>
    </g>
  </g>

  <g data-depth="-0.2">
    <g data-enter="rise" data-enter-at="1.9">
      <rect class="v-node" x="60" y="566" width="120" height="36" rx="18"></rect>
      <text class="v-label" x="120" y="589" text-anchor="middle">UPSELL</text>
    </g>
    <g data-enter="rise" data-enter-at="2">
      <rect class="v-node-coral" x="296" y="566" width="168" height="36" rx="18"></rect>
      <circle class="pulse-node" cx="318" cy="584" r="4" fill="#ff7a5c"></circle>
      <text class="v-label" x="392" y="589" text-anchor="middle">SUBSCRIPTION</text>
    </g>
  </g>
</svg>

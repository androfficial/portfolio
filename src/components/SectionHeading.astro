---
interface Props {
  id: string;
  index: string;
  label: string;
  title: string;
  intro?: string;
}

const { id, index, label, title, intro } = Astro.props;
---

<header class="grid gap-8 lg:grid-cols-12 lg:items-end">
  <div class="lg:col-span-7">
    <p class="flex items-center gap-3 label-mono text-teal" data-reveal>
      <span aria-hidden="true">{index}</span>
      <span class="h-px w-8 bg-line-strong" aria-hidden="true"></span>
      {label}
    </p>
    <h2 id={id} class="section-title mt-6 font-display" data-split>{title}</h2>
  </div>
  {
    intro && (
      <p class="text-lg leading-relaxed text-ink-muted lg:col-span-5 lg:pb-2" data-reveal>
        {intro}
      </p>
    )
  }
</header>

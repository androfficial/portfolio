---
import SectionEyebrow from './SectionEyebrow.astro';
import type { SectionView } from '../data/sections';

interface Props {
  section: SectionView;
}

const { section } = Astro.props;
---

<header class="grid gap-8 lg:grid-cols-12 lg:items-end">
  <div class="lg:col-span-7">
    <SectionEyebrow section={section} />
    <h2 id={section.titleId} class="section-title mt-6 font-display" data-split>{section.title}</h2>
  </div>
  <p class="text-lg leading-relaxed text-ink-muted lg:col-span-5 lg:pb-2" data-reveal>
    {section.intro}
  </p>
</header>

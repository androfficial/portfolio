---
import SectionHeading from './SectionHeading.astro';
import { principles } from '../data/approach';
import { getSection } from '../data/sections';
import { formatIndex } from '../utils/format';

const section = getSection('approach');
---

<section id={section.id} class="py-28 sm:py-36" aria-labelledby={section.titleId} tabindex="-1">
  <div class="shell">
    <SectionHeading section={section} />
    <ol class="mt-16">
      {
        principles.map((principle, position) => (
          <li class="relative grid gap-6 py-10 lg:grid-cols-12 lg:gap-10" data-reveal-group>
            <span class="absolute inset-x-0 top-0 h-px origin-left bg-line-strong" data-line aria-hidden="true" />
            <span
              class="font-display text-5xl font-medium tracking-tight text-transparent [-webkit-text-stroke:1px_var(--color-teal)] lg:col-span-2"
              aria-hidden="true"
              data-reveal
            >
              {formatIndex(position + 1)}
            </span>
            <div class="lg:col-span-5" data-reveal>
              <h3 class="font-display text-2xl leading-tight font-medium tracking-tight sm:text-3xl">
                {principle.title}
              </h3>
              <p class="mt-4 text-lg leading-relaxed text-ink-muted">{principle.text}</p>
            </div>
            <div class="lg:col-span-5 lg:pt-2" data-reveal>
              <p class="label-mono text-coral">In practice</p>
              <p class="mt-3 leading-relaxed">{principle.practice}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

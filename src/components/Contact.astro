---
import Icon from './Icon.astro';
import { contacts, profile } from '../data/profile';
---

<section
  id="contact"
  class="relative isolate overflow-hidden py-32 sm:py-44"
  aria-labelledby="contact-title"
  tabindex="-1"
>
  <div class="contact-glow" aria-hidden="true" data-parallax="0.25"></div>
  <div class="shell">
    <p class="flex items-center gap-3 label-mono text-teal" data-reveal>
      <span aria-hidden="true">06</span>
      <span class="h-px w-8 bg-line-strong" aria-hidden="true"></span>
      Contact
    </p>
    <h2 id="contact-title" class="contact-title mt-8 font-display" data-reveal data-proximity>Let’s talk.</h2>
    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-end">
      <p class="max-w-xl text-lg leading-relaxed text-ink-muted sm:text-xl lg:col-span-6" data-reveal>
        The quickest way to reach me is LinkedIn or Telegram. My public code is on GitHub.
      </p>
      <ul class="flex flex-wrap gap-3 lg:col-span-6 lg:justify-end" data-reveal>
        {
          contacts.map((contact, index) => (
            <li>
              <a
                href={contact.href}
                class:list={['btn', index === 0 ? 'btn-primary' : 'btn-ghost']}
                target="_blank"
                rel="me noopener noreferrer"
                data-magnetic
              >
                <span class="btn-label">
                  <Icon name={contact.id} class="size-4" />
                  {contact.label}
                  <span class="sr-only">, opens in a new tab</span>
                  <Icon name="arrow-up-right" class="size-4 opacity-60" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="mt-16 flex flex-wrap items-center gap-x-3 gap-y-1 label-mono" data-reveal>
      <Icon name="pin" class="size-4 text-coral" />
      {profile.city}, {profile.country}
      <span data-kyiv-clock hidden>· <time data-kyiv-time></time> local time</span>
    </p>
  </div>
</section>

---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { strengths } from '../data/approach';
---

<section id="strengths" class="py-28 sm:py-36" aria-labelledby="strengths-title" tabindex="-1">
  <div class="shell">
    <SectionHeading
      id="strengths-title"
      index="02"
      label="Strengths"
      title="Where I add the most value."
      intro="Six things I do well, each backed by a real project from the last five years."
    />
    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        strengths.map((strength) => (
          <li class="spotlight flex flex-col panel p-7" data-reveal data-spotlight>
            <span class="grid size-12 place-items-center rounded-2xl border border-line bg-navy text-teal">
              <Icon name={strength.icon} class="size-6" />
            </span>
            <h3 class="mt-7 text-xl font-bold tracking-tight">{strength.title}</h3>
            <p class="mt-3 grow leading-relaxed text-ink-muted">{strength.text}</p>
            <p class="mt-6 border-t border-line pt-4 label-mono">{strength.proof}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

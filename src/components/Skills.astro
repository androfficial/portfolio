---
import SectionHeading from './SectionHeading.astro';
import { marqueeItems, skillGroups, skillHighlights } from '../data/skills';
---

<section id="skills" class="overflow-hidden py-28 sm:py-36" aria-labelledby="skills-title" tabindex="-1">
  <div class="shell">
    <SectionHeading
      id="skills-title"
      index="05"
      label="Skills"
      title="Stack and tools."
      intro="Vue and React are my main tools. I have also built an internal admin portal in Angular."
    />

    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        skillHighlights.map((skill) => (
          <li class="spotlight panel p-6" data-reveal data-spotlight>
            <p class="font-display text-2xl font-medium tracking-tight">{skill.name}</p>
            <p class="mt-3 label-mono text-teal">{skill.note}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        skillGroups.map((group) => (
          <div data-reveal>
            <h3 class="border-b border-line pb-3 label-mono">{group.title}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="marquee mt-24 select-none" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map((copy) => (
          <div class="marquee-group flex shrink-0 items-center" data-copy={copy}>
            {marqueeItems.map((item) => (
              <span class="flex items-center">
                <span class="outline-text px-8 font-display text-[clamp(2.75rem,7vw,6rem)] leading-none font-medium tracking-tight">
                  {item}
                </span>
                <span class="size-2 rounded-full bg-coral/70" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

---
import DateRange from './DateRange.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { roles } from '../data/experience';
import { education, languages } from '../data/profile';
import { getSection } from '../data/sections';
import { caseAnchorId } from '../data/work';

const section = getSection('experience');
---

<section id={section.id} class="py-28 sm:py-36" aria-labelledby={section.titleId} tabindex="-1">
  <div class="shell">
    <SectionHeading section={section} />

    <div class="mt-16 grid gap-16 lg:grid-cols-12">
      <div class="relative lg:col-span-8" data-timeline>
        <span class="absolute top-3 bottom-3 left-[7px] w-px bg-line" aria-hidden="true"></span>
        <span
          class="timeline-rail absolute top-3 bottom-3 left-[7px] w-px bg-linear-to-b from-teal to-coral"
          aria-hidden="true"
          data-timeline-rail></span>
        <ol class="grid gap-16">
          {
            roles.map((role) => (
              <li class="relative pl-10 sm:pl-12" data-reveal-group>
                <span
                  class="absolute top-1.5 left-0 grid size-[15px] place-items-center rounded-full border border-line-strong bg-navy"
                  aria-hidden="true"
                >
                  <span class="size-[5px] rounded-full bg-teal" />
                </span>
                <p class="label-mono" data-reveal>
                  <DateRange period={role.period} />
                </p>
                <h3 class="mt-3 font-display text-2xl font-medium tracking-tight sm:text-3xl" data-reveal>
                  {role.company}
                </h3>
                <p class="mt-2 text-ink-muted" data-reveal>
                  {role.title} · {role.location}
                </p>
                <div class="mt-6 grid gap-3">
                  {role.projects.map((project) => (
                    <div class="spotlight panel p-6" data-reveal data-spotlight>
                      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                        <h4 class="text-lg font-bold">
                          {project.name}
                          {project.kind && <span class="font-medium text-ink-muted"> · {project.kind}</span>}
                        </h4>
                        {project.caseId && (
                          <a
                            href={`#${caseAnchorId(project.caseId)}`}
                            class="link-sweep inline-flex items-center gap-1.5 text-sm font-semibold text-teal"
                            data-scroll-link
                          >
                            Read the case
                            <Icon name="arrow-up" class="size-3.5" />
                          </a>
                        )}
                      </div>
                      <p class="mt-3 leading-relaxed text-ink-muted">{project.text}</p>
                      <ul class="mt-5 flex flex-wrap gap-2">
                        {project.stack.map((item) => (
                          <li class="chip">{item}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <aside class="lg:col-span-4" aria-label="Education and languages">
        <div class="grid gap-4 lg:sticky lg:top-28" data-reveal-group>
          <div class="panel p-7" data-reveal>
            <h3 class="label-mono text-teal">Education</h3>
            <ul class="mt-5 grid gap-6">
              {
                education.degrees.map((item) => (
                  <li>
                    <p class="label-mono">
                      <DateRange period={item.period} />
                    </p>
                    <p class="mt-2 font-bold">{item.degree}</p>
                    <p class="mt-1 text-sm leading-relaxed text-ink-muted">{item.field}</p>
                  </li>
                ))
              }
            </ul>
            <p class="mt-6 border-t border-line pt-5 text-sm leading-relaxed text-ink-muted">
              {education.school}, {education.city}
            </p>
          </div>
          <div class="panel p-7" data-reveal>
            <h3 class="label-mono text-teal">Languages</h3>
            <ul class="mt-5 grid gap-3">
              {
                languages.map((language) => (
                  <li class="flex items-baseline justify-between gap-4 border-b border-line pb-3 last:border-0 last:pb-0">
                    <span class="font-bold">{language.name}</span>
                    <span class="text-sm text-ink-muted">{language.level}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

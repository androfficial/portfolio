---
import Icon from '../components/Icon.astro';
import LogoMark from '../components/LogoMark.astro';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`Page not found · ${profile.name}`} description="This page does not exist." indexable={false}>
  <main id="main" class="shell flex min-h-svh flex-col items-start justify-center py-24" tabindex="-1">
    <LogoMark id="not-found" class="size-12" />
    <p class="mt-10 label-mono text-teal">Error 404</p>
    <h1 class="section-title mt-4 font-display">This page does not exist.</h1>
    <p class="mt-5 max-w-lg text-lg text-ink-muted">The link may be old or mistyped. The portfolio is one page away.</p>
    <a href={home} class="btn mt-10 btn-primary">
      <span class="btn-label">
        Back to the portfolio
        <Icon name="arrow-up-right" class="size-4" />
      </span>
    </a>
  </main>
</Base>

---
import Approach from '../components/Approach.astro';
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Motion from '../components/Motion.astro';
import Skills from '../components/Skills.astro';
import Strengths from '../components/Strengths.astro';
import Work from '../components/Work.astro';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title={profile.metaTitle} description={profile.metaDescription}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Work />
    <Strengths />
    <Approach />
    <Experience />
    <Skills />
    <Contact />
  </main>
  <Footer />
  <Motion />
</Base>
